 ////////////////////////////////////////////////

      Widget iconsAuto(int index) {
  final items = ['All', 'coffee', 'burer', 'pizza'];  // 외부 선언 필요 없음
  final name = items[index];

  late IconData con;

  switch (name) {
    case 'All':
      con = Icons.house;
      break;
    case 'coffee':
      con = Icons.local_cafe;
      break;
    case 'burer':
      con = Icons.fastfood;
      break;
    default:
      con = Icons.local_pizza;
  }
  return Column(
    children: [
      Icon(con),
      Text(name),
    ],
  );
}
