Widget iconsIndex(int i) {
  late IconData con;
  late String type;

  switch (i) {
    case 0:
      con = Icons.house;
      type = 'All';
      break;
    case 1:
      con = Icons.local_cafe;
      type = 'coffee';
      break;
    case 2:
      con = Icons.fastfood;
      type = 'burer';
      break;
    default:
      con = Icons.local_pizza;
      type = 'Pizza';
  }

  return Column(
    children: [
      Icon(con),
      Text(type),
    ],
  );
}
